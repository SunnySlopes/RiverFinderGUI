# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/
.kotlin

# External cubiomes checkout required by RiverFinderBase native build (see RiverFinderBase/README.md)
/cubiomes/

# Native libs (built by :riverfinder / bundled into jar at build time)
native/**/*.dll
native/**/*.so
native/**/*.dylib
*.dll
*.so
*.dylib

# Packaged jars outside build/ (avoid committing release artifacts in tree root)
/*.jar

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# VS Code
.vscode/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Logs / temp
*.log
*.tmp
*.temp
